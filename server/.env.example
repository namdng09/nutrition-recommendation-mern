SERVER_URL=
CLIENT_URL=
MONGO_URI=

# For compose deployment
# MONGO_URI=mongodb://host.docker.internal:27017/[your_database_name]
# CLIENT_URL=http://client:5173

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_PASSWORD_SECRET=

MAIL_HOST=
MAIL_PORT=
MAIL_ADDRESS=
MAIL_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_URL=

# AI providers
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# PAYOS
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# RAG (MongoDB Atlas Vector Search)
RAG_ENABLED=false
RAG_VECTOR_COLLECTION=rag_chunks
RAG_VECTOR_INDEX=rag_vector_index
RAG_TEXT_KEY=text
RAG_EMBEDDING_KEY=embedding
RAG_EMBEDDING_MODEL=text-embedding-004
# Recommended for text-embedding-004: 768. If model changes, update this or leave empty to auto-infer.
RAG_EMBEDDING_DIMENSIONS=768
RAG_VECTOR_SIMILARITY=cosine
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=6
