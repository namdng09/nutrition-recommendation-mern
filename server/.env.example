# RAG (MongoDB Atlas Vector Search)
RAG_ENABLED=false
RAG_VECTOR_COLLECTION=rag_chunks
RAG_VECTOR_INDEX=rag_vector_index
RAG_TEXT_KEY=text
RAG_EMBEDDING_KEY=embedding
RAG_EMBEDDING_MODEL=gemini-embedding-001
# Recommended: leave empty to auto-infer dimensions from current embedding model.
RAG_EMBEDDING_DIMENSIONS=
RAG_VECTOR_SIMILARITY=cosine
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_DEFAULT_TOP_K=6
